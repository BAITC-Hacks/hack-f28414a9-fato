# faster-whisper model: tiny, base, small, medium, large-v3, or a local model directory
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500

# Optional pyannote diarization. The Hugging Face token is used only to download
# the gated model on first run. Pre-cache the model for fully offline operation.
HF_TOKEN=
ENABLE_DIARIZATION=false
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
